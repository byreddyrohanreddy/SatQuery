# Google Gemini API key for agentic query routing (Recommended)
# Obtain a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override default Gemini model (defaults to gemini-flash-lite-latest with fallback to gemini-3.6-flash)
# GEMINI_MODEL=gemini-flash-lite-latest

# Optional: Anthropic Claude API key
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
